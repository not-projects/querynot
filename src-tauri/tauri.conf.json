{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueryNot",
  "version": "0.1.1",
  "identifier": "com.notprojects.querynot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "QueryNot",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "createUpdaterArtifacts": true,
    "publisher": "Not Projects",
    "homepage": "https://github.com/not-projects/querynot",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "A local-first desktop SQL client.",
    "longDescription": "QueryNot is a local-first desktop SQL client for SQLite, MySQL, and MariaDB development workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "fileAssociations": [
      {
        "ext": ["sql"],
        "name": "SQL source file",
        "description": "SQL source file opened offline in QueryNot",
        "role": "Editor",
        "mimeType": "application/sql"
      }
    ]
  }
}
